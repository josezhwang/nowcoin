PORT=4000
# Interface to bind; loopback keeps the API private behind the web server's /api proxy.
HOST=127.0.0.1
# Comma-separated list of origins allowed to call the API directly, or * for any.
# Not needed when the site is served by `npm run share` (it proxies /api).
CORS_ORIGIN=http://localhost:5173
# Directory where contact / newsletter submissions are appended (JSONL).
LEADS_DIR=./data
# Help chat: with a key, Claude answers visitors' questions from the site content;
# without one, the chat answers from built-in FAQ keyword matching.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
